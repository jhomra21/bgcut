{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bgcut-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "bgcut.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/models/*", "/runtime/*"]
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "bgcut-models"
    }
  ]
}
