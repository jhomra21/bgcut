{
  "name": "bgremove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "bgremove": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "cli": "bun run src/cli/main.ts",
    "model:prepare": "bun run scripts/prepare-model.ts",
