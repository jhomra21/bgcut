    "onnxruntime-web": "1.30.0",
    "sharp": "0.35.4",
    "solid-js": "2.0.0-rc.8",
    "typegpu": "0.12.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@types/bun": "1.4.2",
    "@typescript/lib-dom": "npm:@types/web@0.0.356",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
